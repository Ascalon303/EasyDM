APP_NAME=EasyDM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=easydm
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# D&D 5e API
DND_API_BASE_URL=https://www.dnd5eapi.co/api

# Laravel AI - pilih salah satu provider
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (alternatif)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Laravel AI default driver (openai / anthropic / gemini)
AI_DEFAULT_DRIVER=openai
